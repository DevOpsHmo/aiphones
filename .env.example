# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo se usa en el servidor (service_role, NO la anon key)
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio (Console > Account Info) ---
# Si defines TWILIO_AUTH_TOKEN, el webhook valida la firma de Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Servidor de voz (WebSocket) ---
# URL publica del voice-server desplegado (Railway/Render/Fly.io)
# Debe ser wss:// (Twilio exige TLS para Media Streams)
VOICE_SERVER_WS_URL=wss://tu-voice-server.railway.app/twilio
